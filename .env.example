# Configuración de Entorno - Innova Fisioterapia Móvil
# Reemplazar con la IP local de la máquina donde corre el backend en tu red WiFi

# Origen de datos para Arquitectura Limpia: 'mock' (offline defensa) | 'api' (backend Node.js + PostgreSQL)
EXPO_PUBLIC_DATA_SOURCE=mock

# URL base del backend Express/NestJS de Kevin
EXPO_PUBLIC_API_URL=http://192.168.100.10:3000/api
